{
  "manifest_version": 3,
  "name": "Highlight2Sheet",
  "version": "1.0.0",
  "description": "Extract highlighted text and send it to n8n.",

  "permissions": [
    "activeTab",
    "storage"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Highlight2Sheet"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}